# -----------------------------------------------------------------
# Cabeceras de seguridad (si el servidor no tiene el módulo, se ignoran sin dar error)
# - nosniff: el navegador no "adivina" el tipo de los archivos
# - SAMEORIGIN: nadie puede meter la web dentro de un marco en otra web (clickjacking)
# - Referrer-Policy: al salir a otra web, solo se envía el dominio, no la dirección completa
# - Permissions-Policy: la web no usa cámara, micrófono, ubicación ni pagos
# -----------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

RewriteEngine On

# -----------------------------------------------------------------
# Dirección única: https://fisioterapiacostadelsol.com (sin www)
# Así Google ve una sola web en lugar de varias copias.
# PRUEBA: de momento con R=302 (temporal, el navegador no lo recuerda).
# Cuando compruebes que funciona, cambia los dos R=302 por R=301 (permanente).
# Si algo falla, borra este bloque y la web vuelve a estar como antes.
# -----------------------------------------------------------------

# www.fisioterapiacostadelsol.com → https://fisioterapiacostadelsol.com
RewriteCond %{HTTP_HOST} ^www\.fisioterapiacostadelsol\.com$ [NC]
RewriteRule ^ https://fisioterapiacostadelsol.com%{REQUEST_URI} [R=302,L]

# http:// → https://
# (la segunda condición evita un bucle en servidores donde el https lo gestiona un proxy)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} ^fisioterapiacostadelsol\.com$ [NC]
RewriteRule ^ https://fisioterapiacostadelsol.com%{REQUEST_URI} [R=302,L]

# -----------------------------------------------------------------
# Si lo que se pide no existe como archivo ni como carpeta...
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# ...redirigir a la página principal
RewriteRule ^ https://fisioterapiacostadelsol.com/ [R=302,L]
